POSTGRES_USER=pilotlog
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pilotlog
DATABASE_URL=postgres://pilotlog:changeme@localhost:5432/pilotlog?sslmode=disable
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Where the API redirects after Google sign-in
WEB_URL=http://localhost:5173
# FlightAware AeroAPI key (Personal tier is fine), for importing recent flights and tracks.
# Leave unset to log flights by hand only.
FLIGHTAWARE_API_KEY=
# Monthly FlightAware spending cap in dollars (resets on the 1st, UTC). Defaults to 4.50,
# just under the $5 of free usage FlightAware includes each month.
FLIGHTAWARE_MONTHLY_BUDGET=4.50
